meta {
  name: app-token-ok
  type: http
  seq: 21
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/app_p1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{oauth2_app_only_token}}
}

script:pre-request {
  // needs a real bkauth token issued to the test_bk_app_code app; skipped when the env var is empty
  if (!bru.getEnvVar("oauth2_app_only_token")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}

tests {
  var atob = require('atob');
  test("check the jwt payload", function() {
    var payload = JSON.parse(atob(res.getBody().headers["X-Bkapi-Jwt"].split(".")[1]));
    expect(payload.app.app_code).to.eql(bru.getEnvVar("test_bk_app_code"));
    expect(payload.app.verified).to.eql(true);
    expect(payload.user.verified).to.eql(false);
  });

  test("the bkauth bearer token is not passed to the backend", function() {
    expect(res.getBody().headers["Authorization"]).to.be.undefined;
  });
}
