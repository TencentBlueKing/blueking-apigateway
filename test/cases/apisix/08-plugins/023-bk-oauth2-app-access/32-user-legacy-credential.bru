meta {
  name: user-legacy-credential
  type: http
  seq: 32
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/ua_p1
  body: none
  auth: none
}

headers {
  X-Bkapi-Authorization: {"access_token": "{{access_token}}"}
  Authorization: Bearer backend-owned-opaque-token
}

assert {
  res.status: eq 200
}

tests {
  var atob = require('atob');
  test("check the jwt payload", function() {
    var payload = JSON.parse(atob(res.getBody().headers["X-Bkapi-Jwt"].split(".")[1]));
    expect(payload.app.verified).to.eql(true);
    expect(payload.user.verified).to.eql(true);
  });

  test("the bearer token is passed to the backend", function() {
    expect(res.getBody().headers["Authorization"]).to.eql("Bearer backend-owned-opaque-token");
  });
}
