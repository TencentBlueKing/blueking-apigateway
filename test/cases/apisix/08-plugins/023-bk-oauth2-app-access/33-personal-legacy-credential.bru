meta {
  name: personal-legacy-credential
  type: http
  seq: 33
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/u_personal
  body: none
  auth: none
}

headers {
  X-Bkapi-Authorization: {"access_token": "{{access_token}}"}
}

assert {
  res.status: eq 200
}

tests {
  var atob = require('atob');
  test("check the jwt payload", function() {
    var payload = JSON.parse(atob(res.getBody().headers["X-Bkapi-Jwt"].split(".")[1]));
    expect(payload.user.verified).to.eql(true);
  });
}
