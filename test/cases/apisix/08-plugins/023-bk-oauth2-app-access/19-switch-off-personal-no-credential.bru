meta {
  name: switch-off-personal-no-credential
  type: http
  seq: 19
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app-off/prod/ua_personal
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.headers['www-authenticate']: contains resource_metadata
  res.body.code_name: eq UNAUTHORIZED
}
