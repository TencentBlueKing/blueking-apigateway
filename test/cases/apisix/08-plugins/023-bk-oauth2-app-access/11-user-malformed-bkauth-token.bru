meta {
  name: user-malformed-bkauth-token
  type: http
  seq: 11
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/ua_p1
  body: none
  auth: none
}

headers {
  Authorization: Bearer bkp_short
}

assert {
  res.status: eq 401
  res.headers['www-authenticate']: contains resource_metadata
  res.body.code_name: eq UNAUTHORIZED
}
