meta {
  name: delegated-token-on-app-resource
  type: http
  seq: 23
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/app_p1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{oauth2_app_delegated_token}}
}

script:pre-request {
  // needs a real bkauth token issued to the test_bk_app_code app; skipped when the env var is empty
  if (!bru.getEnvVar("oauth2_app_delegated_token")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 401
  res.headers['www-authenticate']: contains resource_metadata
  res.body.code_name: eq UNAUTHORIZED
}
