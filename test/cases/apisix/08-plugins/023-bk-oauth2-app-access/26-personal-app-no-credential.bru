meta {
  name: personal-app-no-credential
  type: http
  seq: 26
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/ua_personal
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.headers['www-authenticate']: contains resource_metadata
  res.body.code_name: eq UNAUTHORIZED
}

tests {
  test("the discovery challenge carries no error code", function() {
    expect(res.getHeader("www-authenticate")).to.not.contain("error=");
  });
}
