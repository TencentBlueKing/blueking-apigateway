meta {
  name: access-token-source-blocks-app-channel
  type: http
  seq: 15
}

get {
  url: {{scheme}}://{{host}}/api/oauth2-app/prod/ats_apikey
  body: none
  auth: none
}

headers {
  X-API-KEY: e2e-invalid-api-key
