meta {
  name: v2-inner-list-oauth2-client-scope-resources-app-only
  type: http
  seq: 26
}

get {
  url: {{scheme}}://{{host}}/api/bk-apigateway/prod/api/v2/inner/oauth2/client-scopes/resources/?oauth_client_type=app_only&keyword=oauth2-app&page_size=100
  body: none
  auth: none
}

headers {
  X-Bkapi-Authorization: {"bk_app_code": "{{bk_app_code}}", "bk_app_secret": "{{bk_app_secret}}"}
}

assert {
  res.status: eq 200
  res.body.data.results: isArray
}

tests {
  function resourceNames(gatewayName) {
    var gateway = res.getBody().data.results.find(function(item) { return item.name === gatewayName; });
    return gateway ? gateway.resources.map(function(item) { return item.name; }) : null;
  }

  test("app-only resources are listed", function() {
    expect(resourceNames("oauth2-app")).to.include("app_p1");
  });

  test("user-required, bk-access-token-source and no-auth resources are not listed", function() {
    var names = resourceNames("oauth2-app");
    expect(names).to.not.include.any.members(["ua_p1", "ua_personal", "u_personal", "ats_apikey", "none"]);
  });

  test("a gateway with the app channel switched off is not listed", function() {
    expect(resourceNames("oauth2-app-off")).to.be.null;
  });
}
